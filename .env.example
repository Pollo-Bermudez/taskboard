# ==============================================
# Configuración del Entorno - TaskBoard
# ==============================================

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Base de datos PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=taskboard
DB_USER=taskboard_user
DB_PASSWORD=cambia_esta_contrasena

# Caché Redis
REDIS_HOST=cache
REDIS_PORT=6379

# Autenticación y Seguridad
# Generar con: openssl rand -hex 32
JWT_SECRET=tu_clave_secreta_jwt_aqui_cambiala_en_produccion
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=3
# true solo cuando el sitio se sirve por HTTPS (si no, el navegador no envía la cookie)
COOKIE_SECURE=false

# Solo desarrollo: contraseña común asignada (como hash bcrypt) a los usuarios de prueba
# sin contraseña. Dejar vacío en producción.
SEED_USER_PASSWORD=TaskBoard-dev-2026
